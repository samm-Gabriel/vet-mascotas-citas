# PostgreSQL (Neon). Usa pooler en DATABASE_URL y host directo en DIRECT_URL.
# Añade schema=<nombre_del_repo> en la query string (sin channel_binding).
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&schema=vet_mascotas_citas"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require&schema=vet_mascotas_citas"
